{
  "name": "@happyvertical/ocr",
  "version": "0.61.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.13.0"
  },
  "dependencies": {
    "@gutenye/ocr-common": "^1.4.8",
    "@gutenye/ocr-models": "^1.4.2",
    "@happyvertical/ai": "^0.80.0",
    "@happyvertical/utils": "^0.80.0",
    "onnxruntime-common": "^1.27.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@kreuzberg/node": "4.10.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "2.1.10",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node/index.d.ts"
    }
  },
  "description": "Node-first OCR interface with support for Tesseract.js, ONNX (PaddleOCR), HappyVertical AI-backed vision OCR, and Unlimited-OCR",
  "keywords": [
    "ocr",
    "optical-character-recognition",
    "text-extraction",
    "tesseract",
    "onnx",
    "paddleocr",
    "litellm",
    "unlimited-ocr",
    "sglang",
    "bifrost",
    "vision-llm",
    "image-to-text",
    "text-recognition",
    "multi-provider",
    "typescript",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/ocr.git"
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/ocr/issues"
  },
  "homepage": "https://github.com/happyvertical/ocr#readme",
  "license": "MIT",
  "scripts": {
    "test": "pnpm build && vitest run --testTimeout 120000 && pnpm test:vite-consumer",
    "test:coverage": "pnpm build && vitest run --coverage --testTimeout 120000 && pnpm test:vite-consumer",
    "test:vite-consumer": "node scripts/test-vite-consumer.mjs",
    "test:watch": "vitest --testTimeout 120000",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "deps:check": "node scripts/validate-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "docs:api": "typedoc --options typedoc.json",
    "docs:api:check": "sh -c 'before=$(git status --porcelain -- docs/api); pnpm docs:api; after=$(git status --porcelain -- docs/api); test \"$before\" = \"$after\"'",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "npm run build:watch & npm run test:watch",
    "changeset": "changeset",
    "changeset:auto": "npx tsx scripts/auto-changeset.ts",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "lefthook install"
  }
}
